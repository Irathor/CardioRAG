# Copy to .env (or .env.local) and adjust. Every var must be prefixed
# VITE_ - Vite only exposes prefixed vars to client-side code, by design
# (anything else stays server/build-only and is never bundled).

# The CardioRAG FastAPI backend this client talks to.
VITE_API_BASE_URL=http://localhost:8000

# Only needed if the backend has API_KEY set (see the root .env.example) -
# leave empty otherwise. Note this is NOT a secret once set here: any value
# baked into a browser bundle is visible to whoever opens the page.
VITE_API_KEY=
