# Environment / secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Data: raw PDFs are large/potentially copyrighted, and processed
# artifacts + indexes are regenerated by scripts/build_index.py — none belong in git.
# data/evaluation is exempt: it's a small, hand-authored dataset worth versioning.
data/corpus/*
!data/corpus/.gitkeep
data/references/*
!data/references/.gitkeep
data/processed/*
!data/processed/.gitkeep
indexes/*
!indexes/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# Experiment outputs
notebooks/experiments/*
!notebooks/experiments/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
