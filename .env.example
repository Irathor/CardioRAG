# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (Phase 9: provider abstraction) ---
# One of: "openai", "groq", "huggingface_local", "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq: free-tier, OpenAI-API-compatible hosted inference (get a key at
# https://console.groq.com/keys). Reuses OpenAIProvider under the hood.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# huggingface_local (Phase 20 fix #7): runs entirely offline, no API key -
# needs the "ml" and "tokenization" extras installed (torch + transformers).
HUGGINGFACE_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HUGGINGFACE_LOCAL_DEVICE=auto
HUGGINGFACE_LOCAL_MAX_NEW_TOKENS=512

# --- Embeddings (Phase 4) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
# LRU cache size for repeated query embeddings in the API process (0 disables
# it). Never applies to chunk/ingestion embedding.
QUERY_EMBEDDING_CACHE_SIZE=256

# --- Reranking (Phase 7) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval (Phase 6) ---
RETRIEVAL_TOP_K=5

# --- Paths ---
DATA_DIR=data
CORPUS_DIR=data/corpus
PROCESSED_DIR=data/processed
INDEX_DIR=indexes

# --- API (Phase 15) ---
API_HOST=0.0.0.0
API_PORT=8000
# The web client (web/) has its own separate .env - see web/.env.example -
# since VITE_API_BASE_URL is baked into its static bundle at build time,
# not read from this file at runtime.
# Comma-separated browser origins allowed to call this API, or "*" (default).
# Not a real security boundary (api_key is) - only controls which browser
# tabs may read a response.
CORS_ALLOWED_ORIGINS=*

# --- API security (Phase 20 fix #6) ---
# Leave empty to disable auth entirely (open access, the default for local
# dev). Set a real value to require it as the X-API-Key header on
# /retrieve, /query and /documents - the Streamlit UI reads this same
# variable and sends it automatically. /health is never protected.
API_KEY=
RATE_LIMIT_PER_MINUTE=60
# "memory" (default) is correct only for a single API process. Use "redis"
# if the API ever runs as more than one replica - every replica pointed at
# the same REDIS_URL then shares one rate-limit budget per client.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- Logging (Phase 17) ---
LOG_LEVEL=INFO
